// Production-oriented schema — Phase A control plane (Postgres) + Apps Script execution plane

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Billing & tenancy
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}

enum OrganizationRole {
  owner
  admin
  member
}

model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  maxPipelines  Int?
  maxActions    Int?
  maxActiveJobs Int?
  maxSchedules  Int?
  maxMembers    Int?
  retentionDays Int?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  subscriptions OrganizationSubscription[]
}

/// Hidden system workspace for Phase A (single-tenant until auth ships).
model Organization {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  subscriptions    OrganizationSubscription[]
  executionBackend ExecutionBackend?
  pipelines        Pipeline[]
  actions          Action[]
  jobs             Job[]
  jobHistory       JobHistory[]
  schedules        Schedule[]
  syncRuns         SyncRun[]
  syncOutbox       SyncOutbox[]
  usageMonthly     UsageMonthly[]
}

model User {
  id        String  @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  sessions    Session[]
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  tokenHash            String   @unique
  expiresAt            DateTime
  activeOrganizationId String?
  userAgent            String?
  ipAddress            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model UsageMonthly {
  id             String @id @default(cuid())
  organizationId String
  period         String
  pingCount      Int    @default(0)
  fullCount      Int    @default(0)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(member)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationSubscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  status         SubscriptionStatus @default(active)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  externalCustomerId     String?
  externalSubscriptionId String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Execution infra (Apps Script / future workers)
// ---------------------------------------------------------------------------

enum ExecutionBackendType {
  apps_script
  bullmq
  custom
}

model ExecutionBackend {
  id             String               @id @default(cuid())
  organizationId String               @unique
  type           ExecutionBackendType @default(apps_script)
  isActive       Boolean              @default(true)

  spreadsheetId String?
  webAppUrl     String?
  lastSyncAt    DateTime?
  lastError     String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum SyncRunStatus {
  pending
  running
  completed
  failed
}

model SyncRun {
  id             String        @id @default(cuid())
  organizationId String
  status         SyncRunStatus @default(pending)
  direction      String        @default("from_executor")
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  error          String?
  stats          Json          @default("{}")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

enum SyncOutboxStatus {
  pending
  processing
  completed
  failed
}

/// Pending writes: Postgres → Apps Script (drained by POST /api/internal/sync push).
model SyncOutbox {
  id             String           @id @default(cuid())
  organizationId String
  executorAction String
  entityId       String?
  payload        Json
  status         SyncOutboxStatus @default(pending)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  lastError      String?
  nextRetryAt    DateTime         @default(now())
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRetryAt])
  @@index([status, nextRetryAt])
}

// ---------------------------------------------------------------------------
// Product domain (mirrors Sheets / UI)
// ---------------------------------------------------------------------------

enum JobState {
  waiting
  active
  completed
  failed
  delayed
}

enum ActionType {
  http
  http_ping
  script
}

enum ExecutionMode {
  ping
  full
}

model Pipeline {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  isPaused       Boolean @default(false)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Action {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  type           ActionType
  config         Json
  description    String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Job {
  id             String   @id
  organizationId String
  pipelineName   String
  actionName     String
  data           Json     @default("{}")
  state          JobState
  priority       Int      @default(0)
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  delayMs        Int      @default(0)
  repeatKey      String?
  executionMode  ExecutionMode @default(full)

  processedAt  DateTime?
  failedReason String?
  returnValue  Json?

  executorSyncedAt DateTime?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@index([organizationId, pipelineName])
  @@index([organizationId, createdAt])
  @@index([organizationId, executionMode, state])
}

model JobHistory {
  id             String   @id
  organizationId String
  pipelineName   String
  actionName     String
  data           Json     @default("{}")
  state          JobState
  priority       Int      @default(0)
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  repeatKey      String?
  executionMode  ExecutionMode @default(full)

  processedAt  DateTime?
  finishedAt   DateTime
  failedReason String?
  returnValue  Json?

  metadata   Json     @default("{}")
  archivedAt DateTime @default(now())
  createdAt  DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, finishedAt])
  @@index([organizationId, state])
  @@index([organizationId, pipelineName])
}

model Schedule {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  pipelineName   String
  actionName     String
  data           Json    @default("{}")
  pattern        String
  enabled        Boolean @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}
