# Postgres (control plane) — Prisma CLI loads .env.local via npm run db:*
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dispatch?schema=public"
# Supabase (pooler for app, direct for migrations):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# If password contains @, encode it as %40 in the URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dispatch?schema=public"

# Apps Script (execution plane)
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Internal API — your sync worker calls POST /api/internal/sync
INTERNAL_API_SECRET=generate-a-long-random-string

# async (default): fast UI + outbox; inline: wait on Apps Script per request (Phase A)
SYNC_MODE=async
